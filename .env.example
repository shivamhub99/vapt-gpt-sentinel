# VAPT-GPT Sentinel Environment Configuration
# Mandatory authorization flag: refuses to run scans unless true
SENTINEL_I_OWN_THIS_TARGET=false

# LLM Provider configuration: mock, gemini, anthropic, openai
LLM_PROVIDER=mock

# Provider API Keys (required only when not using mock provider)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Application & Logging settings
LOG_LEVEL=INFO
SENTINEL_AUDIT_LOG_PATH=runs/audit_log.jsonl
SENTINEL_DATABASE_PATH=runs/sentinel.db
